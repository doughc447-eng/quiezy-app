generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model question {
  id        Int      @id @default(autoincrement())
  question  String
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  answer    String
  quizId    Int
  createdAt DateTime @default(now())

  quiz quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model quiz {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())

  question question[]
  results  quizResult[]
}

model quizResult {
  id        Int      @id @default(autoincrement())
  quizId    Int
  score     Int
  total     Int
  createdAt DateTime @default(now())

  quiz quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}
